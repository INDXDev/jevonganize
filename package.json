    "@napi-rs/canvas": "^1.1.0",
    "@zip.js/zip.js": "^2.24.0",
    "ai": "7.0.159",
    "bplist-creator": "^0.3.0",
    "bplist-parser": "^0.5.0",
    "chardet": "^2.2.0",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "exifreader": "^4.52.0",
    "file-type": "^22.3.0",
    "heic-decode": "^2.1.0",
    "hono": "^4.13.16",
    "ignore": "^7.0.14",
    "isbinaryfile": "^6.0.0",
    "koffi": "^3.3.6",
    "mime": "^4.1.2",
    "music-metadata": "^12.3.4",
    "officeparser": "8.5.0",
    "open": "^11.0.4",
    "p-limit": "^7.3.3",
    "picocolors": "^1.1.1",
    "piscina": "^5.3.2",
