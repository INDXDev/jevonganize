{
  "name": "jevonganize",
  "version": "0.1.0",
  "description": "Organize the files you already have: a decision model tags them, and the tags live on the files.",
  "keywords": [
    "cli",
    "decision-model",
    "files",
    "finder-tags",
    "jev",
    "organizer",
    "tags",
    "xattr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INDXDev/jevonganize.git"
  },
  "bin": {
    "jevonganize": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "presets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "main": "dist/desktop/main.mjs",
  "scripts": {
    "dev": "node src/cli.ts",
    "dev:web": "vite",
    "build": "vite build && tsdown",
    "dist": "pnpm build && electron-builder",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip && pnpm test:coverage && pnpm build",
    "prepare": "husky",
    "notices": "node scripts/notices.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.132",
    "@ai-sdk/openai": "4.0.106",
