    "@vitest/coverage-v8": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
